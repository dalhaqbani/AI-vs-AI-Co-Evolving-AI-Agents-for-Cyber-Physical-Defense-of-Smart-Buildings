// Copy this file to config.h and fill in your real values.
//
// config.h is listed in .gitignore, so your Wi-Fi password and broker
// address never get committed to git history. If you ever see config.h
// show up in `git status` as a tracked file, something is wrong with the
// .gitignore, stop and fix that before committing.

#define WIFI_SSID     "YOUR_WIFI_SSID"
#define WIFI_PASSWORD "YOUR_WIFI_PASSWORD"
#define MQTT_HOST     "192.168.1.100"   // LAN IP of the machine running the broker
#define MQTT_PORT     1883
